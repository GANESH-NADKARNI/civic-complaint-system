# ─── Server Configuration ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database Configuration ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=civic_complaints
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# ─── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET=your_random_64_character_string_use_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# ─── Meta WhatsApp Business API ─────────────────────────────────────────────
# Get these from: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WA_ACCESS_TOKEN=your_whatsapp_business_api_access_token
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_VERIFY_TOKEN=your_webhook_verify_token

# ─── State & URLs ───────────────────────────────────────────────────────────
STATE_CODE=KA
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
